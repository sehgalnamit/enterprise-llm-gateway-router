# Copy to .env and fill in only what you need. Every value below is OPTIONAL --
# the gateway runs fully offline against MockProvider personas with no .env at all.

# --- Gateway / cache / circuit breaker tuning (all have safe defaults) ---
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_USE_FAKE_REDIS_IF_UNREACHABLE=true
GATEWAY_CACHE_SIMILARITY_THRESHOLD=0.92
GATEWAY_CACHE_TTL_SECONDS=3600
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
GATEWAY_CIRCUIT_WINDOW_SECONDS=60
GATEWAY_CIRCUIT_RECOVERY_TIMEOUT_S=5
GATEWAY_CIRCUIT_MAX_RECOVERY_TIMEOUT_S=60
GATEWAY_JURY_SCORE_THRESHOLD=0.4

# --- Real OpenAI provider (optional; disabled/failover-skipped if unset) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Real GCP Vertex AI provider (optional) ---
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_ACCESS_TOKEN=

# --- Real local Ollama provider (optional; auto-skipped if unreachable) ---
OLLAMA_HOST=http://localhost:11434
